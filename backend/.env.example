# Application Settings
PROJECT_NAME="TruthLens News Aggregator"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS Configuration (Next.js Frontend URLs)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Connection (PostgreSQL or local SQLite for testing)
# Example for local PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/news_aggregator
# Example for SQLite fallback: sqlite+aiosqlite:///./news_aggregator.db
DATABASE_URL="sqlite+aiosqlite:///./news_aggregator.db"

# News Ingestion Settings
INGESTION_INTERVAL_MINUTES=15
MAX_ARTICLES_PER_FEED=20

# Fact Check API Settings (Optional Google Fact Check Tools API Key)
GOOGLE_FACT_CHECK_API_KEY=""
